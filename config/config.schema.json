{
  "title": "config.yaml",
  "description": "config.yaml 的统一 JSON Schema。约束 cards 清单与 agent 参数。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "cards": {
      "type": "object",
      "required": ["__list"],
      "properties": {
        "__list": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
            "minLength": 1
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "baseURL": { "type": "string", "minLength": 1 },
        "apiKey": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number" },
        "maxTokens": { "type": "number", "minimum": 1 },
        "timeoutMs": { "type": "number", "minimum": 1 },
        "minCases": { "type": "number", "minimum": 1 },
        "systemPrompt": { "type": "string" }
      }
    }
  }
}
